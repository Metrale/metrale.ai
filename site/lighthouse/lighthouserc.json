{
  "ci": {
    "collect": {
      "staticDistDir": "./site/build",
      "url": [
        "http://localhost/index.html",
        "http://localhost/why-metrale.html",
        "http://localhost/pricing.html",
        "http://localhost/engine.html",
        "http://localhost/control.html",
        "http://localhost/diligence.html",
        "http://localhost/platform.html",
        "http://localhost/platform/engine.html",
        "http://localhost/platform/control.html",
        "http://localhost/platform/economics.html",
        "http://localhost/platform/security.html",
        "http://localhost/platform/deployment.html",
        "http://localhost/platform/hardware.html",
        "http://localhost/benchmarks.html",
        "http://localhost/solutions.html",
        "http://localhost/solutions/neoclouds.html",
        "http://localhost/solutions/enterprise-datacenter.html",
        "http://localhost/solutions/financial-services.html",
        "http://localhost/solutions/healthcare.html",
        "http://localhost/solutions/government-defense.html",
        "http://localhost/solutions/public-safety.html",
        "http://localhost/solutions/local-government.html",
        "http://localhost/solutions/legal.html",
        "http://localhost/solutions/hyperscalers.html",
        "http://localhost/solutions/research.html",
        "http://localhost/solutions/smb-edge.html",
        "http://localhost/demo.html",
        "http://localhost/waitlist.html",
        "http://localhost/resources.html",
        "http://localhost/resources/updates.html",
        "http://localhost/resources/events.html",
        "http://localhost/resources/contributors.html",
        "http://localhost/labs.html",
        "http://localhost/company.html",
        "http://localhost/company/careers.html",
        "http://localhost/contact.html",
        "http://localhost/trust.html"
      ],
      "numberOfRuns": 5,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
        "categories:seo": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
        "categories:performance": ["error", { "minScore": 1, "aggregationMethod": "optimistic" }],
        "resource-summary:third-party:count": ["error", { "maxNumericValue": 0 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
