{
  "config": {
    "default": true,
    // The docs are hand-wrapped prose with wide tables; line length is not a defect here.
    "MD013": false
  },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "**/build/**",
    "**/.svelte-kit/**",
    "**/test-results/**",
    "**/playwright-report/**",
    ".claude/**",
    ".inputs/**",
    // Generated by `bun run guide`; `bun run guide:check` is its gate.
    "site/SITE-GUIDE.md",
    // The blog's posts are content with conventions of their own, not documents.
    "blog/src/lib/posts/**"
  ]
}
